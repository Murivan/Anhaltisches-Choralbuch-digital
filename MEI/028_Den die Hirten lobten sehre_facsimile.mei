      <titleStmt>
        <title xml:id="sngttl"> 
          <titlePart type="number">28</titlePart>
          <titlePart type="main">Den die Hirten lobten sehre</titlePart>
          <titlePart type="alternative" xml:id="alt">Kommt und lasst uns Christum ehren</titlePart>
          <titlePart type="alternative" xml:lang="lat">Quem pastores laudavere</titlePart>
        </title>
