    <fileDesc>
      <titleStmt>
        <title xml:id="sngttl"> 
          <titlePart type="number">58</titlePart>
          <titlePart type="main">Geduld, die soll'n wir haben allhier auf dieser Erd</titlePart>
          <titlePart type="alternative">Freut euch, ihr lieben Christen</titlePart>
          <titlePart type="alternative">Dank sei Gott in  der Höhe</titlePart>
        </title>
        <respStmt>
          <persName role="composer_melody" xml:id="cmpsrMld" auth="GND" auth.uri="http://d-nb.info/gnd/" codedval="118694405">Bartholomäus Gesius</persName>
